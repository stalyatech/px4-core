menuconfig DRIVERS_DISTANCE_SENSOR_MR72
	bool "mr72"
	default n
	---help---
		Enable support for the Nanoradar MR72 radar

if DRIVERS_DISTANCE_SENSOR_MR72

choice
	prompt "MR72 interface"
	default MR72_IFACE_UART
	---help---
		The MR72 comes as a UART or a CAN model; select the one fitted.

config MR72_IFACE_UART
	bool "UART"
	---help---
		UART model, 115200 baud. Reports the nearest target of three
		sectors. Port set with SENS_MR72_CFG.

config MR72_IFACE_CAN
	bool "CAN"
	---help---
		CAN model, 500 kbit/s classic CAN through SocketCAN. Reports the
		full object list (distance, lateral offset, velocity, RCS). Port
		set with SENS_MR72_CAN, radar SensorID with SENS_MR72_ID.

endchoice

endif
