# NXP SE050A2HQ1/Z01SHZ secure element on I2C2 @ 0x48
CONFIG_DRIVERS_SECURE_ELEMENT_SE050=y

# TPU-v2 (SG2000 RISC-V) is the IO board for the nexus profile.
CONFIG_BOARD_IO="stalya_tpu-v2_default"

# IO firmware is provisioned out-of-band by the mission computer over a shared
# resource; the FMU must not embed or upload it on boot.
CONFIG_BOARD_NO_ROMFS_IO_FW=y

CONFIG_MODULES_UXRCE_DDS_CLIENT=y

# Nanoradar MR72 CAN model on the tilt rig (port and id: SENS_MR72_CAN, SENS_MR72_ID)
CONFIG_MR72_IFACE_CAN=y

# Nanoradar NRA15 CAN model on the tilt rig (port: SENS_NRA15_CAN)
CONFIG_NRA15_IFACE_CAN=y

# simpleTRAP FMU revision fitted on the tilt rig
CONFIG_BOARD_FMU_REV02=y

# TELEM4 to the TPU Linux UART2 (needs the U13 pin 1-3 bridge on the TPU)
CONFIG_BOARD_TPU_TELEM4_SWAP=y

# TX/RX swap tool for the TELEM4 bring-up
CONFIG_SYSTEMCMDS_SERIAL_SWAP=y

# Gimbal module drives the rig tilt servo (MAVLink gimbal protocol in, AUX out)
CONFIG_MODULES_GIMBAL=y
# Tilt rig: platform tilt to radar pose converter and radar simulators
CONFIG_MODULES_RIG_POSE=y
CONFIG_MODULES_TILT_RIG=y
CONFIG_EXAMPLES_FAKE_NRA15=y
CONFIG_EXAMPLES_FAKE_MR72=y
