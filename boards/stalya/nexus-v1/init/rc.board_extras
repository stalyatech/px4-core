#!/bin/sh
#
# Board specific applications init
#------------------------------------------------------------------------------

# Override VTOL default: no airspeed sensor required
param set-default SYS_HAS_NUM_ASPD 0
param set-default FW_USE_AIRSPD 0

# Activate serial port baud parameters so they appear in QGC
param touch SER_GPS1_BAUD
param touch SER_GPS2_BAUD
param touch SER_TEL1_BAUD
param touch SER_TEL2_BAUD
param touch SER_TEL3_BAUD
param touch SER_TEL4_BAUD

# Activate pump parameters so they appear in QGC
#param touch PWM_PUMP_MIN
#param touch PWM_PUMP_MAX
#param touch PWM_PUMP_DISARM

# Activate tank parameters so they appear in QGC
param touch TANK_FLOW_INP
param touch TANK_EMPTY_ACT
param touch TANK_VOL_MAX
param touch TANK_FLOW_CONV

# Activate spray parameters so they appear in QGC
param touch SPRAY_MODE
param touch SPRAY_ENABLE
param touch SPRAY_SWITCHOFF
param touch SPRAY_CHANNEL
param touch SPRAY_VOLUME
param touch SPRAY_WIDTH
param touch SPRAY_VELOCITY
param touch SPRAY_SPEED_CUR

if param greater SPRAY_SPEED_MAX 0
then
	#
	# Start the Spraying module
	#
	spray start
fi

#
# Check the frequency measurement config
#
if param greater SENS_FREQ_CONFIG 0
then
	#
	# Start the Frequency Measurement module
	#
	freq_input start

	#
	# Check the tank level estimator config
	#
	if param greater TANK_FLOW_INP 0
	then
		#
		# Start Tank Level Estimator
		#
		tank_level start
	fi
fi

# Configure USB MAVLink IMU streams only if instance already exists.
if mavlink stream -d /dev/ttyACM0 -s HIGHRES_IMU -r 10
then
	mavlink stream -d /dev/ttyACM0 -s SCALED_IMU -r 10
	mavlink stream -d /dev/ttyACM0 -s SCALED_IMU2 -r 10
	mavlink stream -d /dev/ttyACM0 -s SCALED_IMU3 -r 10
	mavlink stream -d /dev/ttyACM0 -s VIBRATION -r 2
fi
