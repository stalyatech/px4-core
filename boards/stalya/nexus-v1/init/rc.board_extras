#!/bin/sh
#
# Board specific applications init
#------------------------------------------------------------------------------

#
# Dummy check the pump parameters
#
if param greater PWM_PUMP_MIN 0
then
fi
if param greater PWM_PUMP_MAX 0
then
fi
if param greater PWM_PUMP_DISARM 0
then
fi

#
# Dummy check the tank parameters
#
if param greater TANK_FLOW_INP 0
then
fi
if param greater TANK_EMPTY_ACT 0
then
fi
if param greater TANK_VOL_MAX 0
then
fi
if param greater TANK_FLOW_CONV 0
then
fi

#
# Dummy check the spray parameters
#
if param greater SPRAY_MODE 0
then
fi

if param greater SPRAY_ENABLE 0
then
fi

if param greater SPRAY_SWITCHOFF 0
then
fi

if param greater SPRAY_CHANNEL 0
then
fi

if param greater SPRAY_VOLUME 0
then
fi

if param greater SPRAY_WIDTH 0
then
fi

if param greater SPRAY_VELOCITY 0
then
fi

if param greater SPRAY_SPEED_CUR 0
then
fi

if param greater SPRAY_SPEED_MAX 0
then
	#
	# Start the Spraying module
	#
	spray start
fi

#
# Check the frequency measurement config
#
if param greater SENS_FREQ_CONFIG 0
then
	#
	# Start the Frequency Measurement module
	#
	freq_input start

	#
	# Check the tank level estimator config
	#
	if param greater TANK_FLOW_INP 0
	then
		#
		# Start Tank Level Estimator
		#
		tank_level start
	fi
fi

# Configure USB MAVLink IMU streams after USB autostart has run in rcS.
echo "rc.board_extras: configuring USB MAVLink IMU streams"
if ! mavlink stream -d /dev/ttyACM0 -s HIGHRES_IMU -r 50
then
	echo "rc.board_extras: /dev/ttyACM0 has no MAVLink instance yet, starting one"
	mavlink start -d /dev/ttyACM0 -m onboard
	mavlink stream -d /dev/ttyACM0 -s HIGHRES_IMU -r 50
fi

mavlink stream -d /dev/ttyACM0 -s SCALED_IMU -r 50
mavlink stream -d /dev/ttyACM0 -s SCALED_IMU2 -r 50
mavlink stream -d /dev/ttyACM0 -s SCALED_IMU3 -r 50
mavlink stream -d /dev/ttyACM0 -s VIBRATION -r 20
