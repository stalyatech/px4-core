#!/bin/sh
#
# Board specific defaults
#------------------------------------------------------------------------------

param set-default BAT1_V_DIV 38.25
param set-default BAT2_V_DIV 38.25

param set-default BAT1_A_PER_V 0
param set-default BAT2_A_PER_V 0

# Enable IMU thermal control
param set-default SENS_EN_THERMAL 1
param set-default -s SENS_TEMP_ID 3932170

#------------------------------------------------------------------------------
# GNSS-denied navigation: visual aiding + RTK heading + graceful fallback
#
# The mission computer publishes the absolute VBL fix to aux_global_position and
# an external-vision yaw to vehicle_visual_odometry. Optical flow gives velocity
# aiding. With these aids running continuously, EKF2 falls back seamlessly when
# the real GNSS is jammed/spoofed/rejected (EKF2_GPS_CHECK default 2047 already
# gates sat/PDOP/EPH/EPV/SACC/drift/spoofing; EKF2_GPS_MODE Automatic resets to
# the remaining sources on GNSS timeout).

# Absolute visual fix (lat/lon) -> aux global position, horizontal only.
param set-default EKF2_AGP_CTRL 1
param set-default EKF2_AGP_MODE 0
param set-default EKF2_AGP_DELAY 100	# tune to measured VBL + uXRCE-DDS latency

# Optical flow velocity aiding (bounds drift between absolute fixes).
# Set EKF2_OF_POS_{X,Y,Z} to the camera offset from the IMU for this airframe.
param set-default EKF2_OF_CTRL 1

# Height reference: baro (robust when GNSS is denied), not GPS.
param set-default EKF2_HGT_REF 0

# Heading: dual-antenna RTK GNSS yaw when GNSS is available (bit 3) in addition
# to lon/lat + alt + 3D velocity. Set EKF2_GPS_YAW_OFF to the antenna baseline
# offset (deg) for this airframe.
param set-default EKF2_GPS_CTRL 15

# External vision: YAW (bit 3, VBL absolute heading -> mag-independent in denied
# mode) + VELOCITY (bit 2, Tier-2 mc-vio ground odometry -> bounds drift between
# absolute fixes). Bits 0/1 (EV position) stay off; absolute position is AGP.
param set-default EKF2_EV_CTRL 12
param set-default EKF2_EV_DELAY 100	# tune to measured VBL/VIO + uXRCE-DDS latency
#------------------------------------------------------------------------------

# Dataman backend selection based on SD card availability.
#
# nexus-v1 has an FMU SD card slot but the card may or may not be present at
# boot. When absent, dataman's default file backend tries (and fails) to open
# /fs/microsd/dataman, which makes dataman task exit silently. Every mavlink
# instance then blocks ~15-20 s in DatamanClient retry loops (3x3 s per client
# + geofence/safepoint reads) during MavlinkMissionManager construction, which
# delays USB mavlink startup and QGC auto-connect by 90-120 s.
#
# Use $STORAGE_AVAILABLE (set by nexfmu_common rcS after the SD mount attempt)
# to pick the right backend, and `param set` (not set-default) so the value is
# written to user_config and overrides any MTD-stored value from a previous
# boot — keeps the board self-healing across SD insertion/removal cycles.
if [ $STORAGE_AVAILABLE = yes ]
then
	# SD mounted — use default file backend (persistent mission storage)
	param set SYS_DM_BACKEND 0
else
	# No SD — force RAM backend to avoid file init failure at boot
	param set SYS_DM_BACKEND 1
fi

# IO firmware on this board lives on the mission computer (TPU-v2 image at
# /lib/firmware/firmware.elf, loaded into the C906L coprocessor by Linux
# remoteproc). Clear IOFW so rcS skips the legacy upload path and instead
# uses `px4io fw verify/update`, which talks to the MC tpufw daemon over
# the page-56 / cmdqu bridge.
set IOFW ""

safety_button start
